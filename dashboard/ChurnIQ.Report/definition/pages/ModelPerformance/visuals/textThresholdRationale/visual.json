                  {
                    "value": "Why 0.50 was rejected",
                    "textStyle": {
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "10pt",
                      "fontWeight": "bold",
                      "color": "#252423"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The 0.50 default assumes a false positive and a false negative cost the same, which retention economics do not: a wrongly flagged customer wastes one $60 retention offer, while a missed churner forgoes roughly $234 of expected saved revenue (12 months of charges × 30% acceptance). The tuned 0.55 threshold instead maximises expected campaign uplift — value retained minus campaign spend, measured against doing nothing — so it follows the cost and acceptance assumptions in config.yaml rather than a statistical default.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9pt",
                      "color": "#323130"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
