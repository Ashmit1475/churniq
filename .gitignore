__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
.env.*
!.env.example
.ipynb_checkpoints/
.pytest_cache/
.DS_Store

# Editors and logs
.vscode/
.idea/
*.log

# Data and artifacts - regenerate with the pipeline, don't commit
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.db
*.sqlite
*.sqlite3
models/*.pkl
models/*.joblib
reports/*.csv
reports/metrics.json

# ...except the two artifacts the deployed Streamlit app runs from. The cloud
# instance has no SQLite database, so these must be in the repo or the app has
# no model and no data. Both are small (11 KB and 1.3 MB).
!models/churn_pipeline.pkl
!reports/scored_customers.csv

# Keep figures so the README renders on GitHub
!reports/figures/*.png

# Power BI Project - local cache and per-user settings, never commit
**/.pbi/localSettings.json
**/.pbi/cache.abf
**/.pbi/unappliedChanges.json
